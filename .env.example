PORT=3000

# ── Neo4j Aura DB ─────────────────────────────────────────────────────────────
# Cloud console: https://console.neo4j.io
NEO4J_URI=neo4j+s://<your-aura-db-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_aura_password

# ── Azure Database for PostgreSQL (Flexible Server) ──────────────────────────
# Azure Portal → PostgreSQL server → Connect → PostgreSQL authentication
AZURE_PG_HOST=<your-server>.postgres.database.azure.com
AZURE_PG_PORT=5432
AZURE_PG_DATABASE=lexigraph
AZURE_PG_USER=<your-admin-username>
AZURE_PG_PASSWORD=your_pg_password

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Azure Portal → Storage Account → Security + networking → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=lexigraph-uploads

# ── Azure Entra ID — App Registration ────────────────────────────────────────
# Azure Portal → Microsoft Entra ID → App registrations → your app → Overview
# Used for Container App identity; not required for API auth (JWT_SECRET handles that)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
# This signs all access and refresh tokens issued by /auth/register and /auth/login
JWT_SECRET=your_strong_random_secret_here

# ── LLMs ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
